# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env a git.

# Supabase (base de datos)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_KEY=sb_secret_TU_SERVICE_ROLE_KEY

# Anthropic (modelo de los agentes)
# Opcional: si falta, los tests usan modelo mock. Para ejecución real, requerida.
ANTHROPIC_API_KEY=sk-ant-TU_API_KEY

# Modelo por defecto
ANTHROPIC_MODEL=claude-sonnet-4-5

# Logging
LOG_LEVEL=INFO
